{
  "name": "platebeam",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate:pg": "drizzle-kit generate --dialect postgresql --schema src/server/db/schema/pg/index.ts --out supabase/migrations",
    "db:generate:mysql": "drizzle-kit generate --dialect mysql --schema src/server/db/schema/mysql/index.ts --out drizzle/mysql",
    "db:seed": "tsx src/server/db/seed.ts"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@oddbird/popover-polyfill": "^0.7.3",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.4",
    "drizzle-orm": "^0.45.2",
    "idb": "^8.0.3",
    "lucide-react": "^0.511.0",
    "mysql2": "^3.14.1",
    "next": "latest",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "react": "latest",
    "react-dom": "latest",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.26.0",
    "eslint-config-next": "latest",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}
